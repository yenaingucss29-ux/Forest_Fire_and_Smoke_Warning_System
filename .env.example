# Copy this file to .env and fill in the values.

# Resend API key: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# Who gets the smoke alerts. With the free onboarding@resend.dev sender, this must be
# the same email you signed up to Resend with.
ALERT_EMAIL_TO=you@example.com

# Sender. Keep onboarding@resend.dev until you verify your own domain in Resend.
ALERT_EMAIL_FROM=Smoke Alert <onboarding@resend.dev>

# Password for the /admin dashboard. Leave empty to leave /admin open to anyone
# (fine on your own computer, not on a public link).
ADMIN_PASSWORD=

# Default minimum confidence (0.01-0.99) for a detection to count as smoke. The /admin dashboard can
# override it; its "Reset" button goes back to this value. 0.30 had the best F1 score on the validation set.
CONFIDENCE_THRESHOLD=0.30

# Paths relative to this folder (defaults shown).
# MODEL_PATH=model/best.pt
# ULTRALYTICS_DIR=vendor
